<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>HireHub</display-name>
    <description>HireHub – Online Job Portal</description>

    <!-- Welcome file list -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>JobServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.JobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JobServlet</servlet-name>
        <url-pattern>/seeker/jobs</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResumeServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.ResumeServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>6291456</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResumeServlet</servlet-name>
        <url-pattern>/seeker/resume</url-pattern>
        <url-pattern>/seeker/resume/*</url-pattern>
        <url-pattern>/seeker/resume/download</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApplyJobServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.ApplyJobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplyJobServlet</servlet-name>
        <url-pattern>/seeker/apply</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApplicationServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.ApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/seeker/applications</url-pattern>
    </servlet-mapping>

    <!-- Employer Servlets -->
    <servlet>
        <servlet-name>EmployerDashboardServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.EmployerDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployerDashboardServlet</servlet-name>
        <url-pattern>/employer/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployerJobServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.EmployerJobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployerJobServlet</servlet-name>
        <url-pattern>/employer/jobs</url-pattern>
        <url-pattern>/employer/post-job</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployerApplicantServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.EmployerApplicantServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployerApplicantServlet</servlet-name>
        <url-pattern>/employer/applications</url-pattern>
        <url-pattern>/employer/applicants</url-pattern>
        <url-pattern>/employer/applications/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployerResumeServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.EmployerResumeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployerResumeServlet</servlet-name>
        <url-pattern>/employer/resume/download</url-pattern>
    </servlet-mapping>

    <!-- Profile Servlets -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/profile/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfilePhotoServlet</servlet-name>
        <servlet-class>com.hirehub.servlet.ProfilePhotoServlet</servlet-class>
        <multipart-config>
            <max-file-size>2097152</max-file-size>
            <max-request-size>3145728</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfilePhotoServlet</servlet-name>
        <url-pattern>/profile/photo</url-pattern>
        <url-pattern>/profile/photo/upload</url-pattern>
        <url-pattern>/profile/photo/remove</url-pattern>
    </servlet-mapping>

    <!-- Authentication Filter (ensures logged-in session) -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.hirehub.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/employer/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/seeker/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/profile</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/profile/*</url-pattern>
    </filter-mapping>

    <!-- Role Authorization Filter (enforces role boundaries) -->
    <filter>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <filter-class>com.hirehub.filter.RoleAuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/employer/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleAuthorizationFilter</filter-name>
        <url-pattern>/seeker/*</url-pattern>
    </filter-mapping>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Error pages -->
    <error-page>
        <error-code>403</error-code>
        <location>/access-denied.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

</web-app>
